# Dependencies
/node_modules/

# Persistent and legacy runtime data
/.data/
/data/
/ilkkm_backup/
/ilkkm_files/
/repair-backups/
/backup-temp/
/.secure-backups/

# Databases and database sidecar files must never be committed
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# Local environment configuration
/.env
/.env.*
!/.env.example
*.pem
*.key

# Logs and local server output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/.server.*

# Temporary backup, restore, and integration artifacts
/.restore-*
/.mega-*
/.full-*
/.delete-*
/*-integration-data/
/*-test-data/
*.tmp
*.temp
*.bak
*.backup

# Test coverage
/coverage/
/.nyc_output/

# Editors and operating systems
/.idea/
/.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
